
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexora-ai",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
