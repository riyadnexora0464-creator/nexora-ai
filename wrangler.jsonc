
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexora-ai",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AI_CHAT_LIMITER",
      "namespace_id": "2026110201",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
