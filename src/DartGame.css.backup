
.neon-archery {
  width: 100%;
  max-width: 1300px;
  margin: 0 auto;
  padding: 24px;
  box-sizing: border-box;
  color: #effaff;
  background:
    radial-gradient(ellipse at 85% 0%, rgba(112, 50, 204, 0.2), transparent 45%),
    #080b18;
  border: 1px solid rgba(77, 224, 255, 0.24);
  border-radius: 18px;
  font-family: Inter, system-ui, sans-serif;
}

.neon-archery * {
  box-sizing: border-box;
}

.neon-archery-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.neon-archery-kicker {
  margin: 0 0 8px;
  color: #5beaff;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 3px;
}

.neon-archery-header h2 {
  margin: 0;
  color: #f6f7ff;
  font-size: clamp(26px, 4vw, 40px);
  font-weight: 900;
  letter-spacing: -1px;
  text-shadow: 0 0 25px rgba(75, 224, 255, 0.2);
}

.neon-archery-subtitle {
  margin: 9px 0 0;
  color: #a0accb;
  font-size: 14px;
  line-height: 1.6;
}

.neon-archery-restart {
  flex-shrink: 0;
  padding: 13px 20px;
  color: #07101d;
  background: linear-gradient(100deg, #54edff, #b1faff);
  border: 0;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 1px;
  cursor: pointer;
  box-shadow: 0 0 20px rgba(65, 229, 255, 0.2);
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.neon-archery-restart:hover {
  transform: translateY(-2px);
  box-shadow: 0 0 28px rgba(65, 229, 255, 0.4);
}

.neon-archery-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 15px;
}

.neon-archery-stat {
  min-width: 0;
  padding: 15px;
  background: rgba(19, 26, 51, 0.9);
  border: 1px solid rgba(120, 153, 221, 0.2);
  border-radius: 10px;
}

.neon-archery-stat span {
  display: block;
  margin-bottom: 9px;
  color: #8f9fbe;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 1.1px;
}

.neon-archery-stat strong {
  display: block;
  color: #67edff;
  font-size: 25px;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.neon-archery-record {
  border-color: rgba(255, 208, 93, 0.45);
  background: linear-gradient(
    140deg,
    rgba(66, 48, 44, 0.75),
    rgba(25, 24, 48, 0.9)
  );
}

.neon-archery-record span {
  color: #f6ce77;
}

.neon-archery-record strong {
  color: #ffe19a;
  text-shadow: 0 0 14px rgba(255, 199, 91, 0.2);
}

.neon-archery-canvas-wrap {
  width: 100%;
  overflow: hidden;
  background: #090c22;
  border: 1px solid rgba(80, 226, 255, 0.48);
  border-radius: 12px;
  box-shadow:
    0 0 28px rgba(56, 206, 255, 0.1),
    inset 0 0 25px rgba(75, 65, 180, 0.1);
}

.neon-archery-canvas {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 25 / 14;
  cursor: crosshair;
  touch-action: none;
  user-select: none;
}

.neon-archery-footer {
  margin-top: 15px;
  padding: 15px 17px;
  background: rgba(20, 26, 52, 0.75);
  border: 1px solid rgba(121, 148, 211, 0.16);
  border-radius: 10px;
}

.neon-archery-message {
  margin: 0 0 8px;
  color: #65edff;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 1.4px;
}

.neon-archery-help {
  margin: 0;
  color: #a7b4d1;
  font-size: 13px;
  line-height: 1.7;
}

.neon-archery-help strong {
  color: #e2eaff;
}

@media (max-width: 700px) {
  .neon-archery {
    padding: 13px;
    border-radius: 12px;
  }

  .neon-archery-header {
    align-items: stretch;
    flex-direction: column;
  }

  .neon-archery-restart {
    width: 100%;
  }

  .neon-archery-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .neon-archery-stat {
    padding: 11px;
  }

  .neon-archery-stat span {
    font-size: 9px;
  }

  .neon-archery-stat strong {
    font-size: 21px;
  }

  .neon-archery-footer {
    padding: 12px;
  }

  .neon-archery-help {
    font-size: 12px;
  }
}
